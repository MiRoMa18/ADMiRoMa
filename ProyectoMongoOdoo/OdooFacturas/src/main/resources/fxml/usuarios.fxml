<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.UsuariosController"
      spacing="15.0" style="-fx-background-color: #ECEFF1;">
    
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="👥 Gestión de Usuarios" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Button fx:id="btnNuevoUsuario" text="➕ Nuevo Usuario" onAction="#crearUsuario"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; 
                       -fx-cursor: hand; -fx-padding: 10px 20px; -fx-font-weight: bold;"/>
        
        <Button fx:id="btnRefrescar" text="🔄 Actualizar" onAction="#cargarUsuarios"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; 
                       -fx-cursor: hand; -fx-padding: 10px 20px;"/>
    </HBox>

    <!-- Filtros -->
    <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 5px;">
        <Label text="Buscar:"/>
        <TextField fx:id="txtBuscar" promptText="Nombre o usuario..." 
                   prefWidth="300.0" onKeyReleased="#filtrarUsuarios"/>
        
        <Label text="Rol:"/>
        <ComboBox fx:id="cmbRol" prefWidth="150.0" onAction="#filtrarUsuarios"/>
        
        <Label text="Estado:"/>
        <ComboBox fx:id="cmbEstado" prefWidth="120.0" onAction="#filtrarUsuarios"/>
        
        <Label fx:id="lblTotal" text="Total: 0 usuarios" style="-fx-text-fill: #666666;">
            <font>
                <Font name="System Bold" size="12.0"/>
            </font>
        </Label>
    </HBox>

    <!-- Tabla de usuarios -->
    <TableView fx:id="tableUsuarios" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 5px;">
        <columns>
            <TableColumn fx:id="colUsername" text="Usuario" prefWidth="120.0"/>
            <TableColumn fx:id="colNombre" text="Nombre Completo" prefWidth="200.0"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200.0"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="120.0"/>
            <TableColumn fx:id="colFechaCreacion" text="Fecha Creación" prefWidth="120.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="200.0"/>
        </columns>
        
        <placeholder>
            <Label text="No hay usuarios para mostrar" style="-fx-text-fill: #999999;"/>
        </placeholder>
    </TableView>

    <!-- Barra de estado -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label fx:id="lblEstado" text="Listo" style="-fx-text-fill: #666666;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblConexion" text="● Conectado a MongoDB" style="-fx-text-fill: #4CAF50;"/>
    </HBox>

</VBox>
