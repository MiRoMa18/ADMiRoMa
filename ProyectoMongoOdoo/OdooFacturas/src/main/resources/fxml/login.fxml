<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.LoginController"
            prefHeight="500.0" prefWidth="400.0"
            style="-fx-background-color: #f5f5f5;">

    <VBox alignment="CENTER" spacing="20.0" AnchorPane.topAnchor="0.0" 
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" 
          AnchorPane.rightAnchor="0.0">
        
        <padding>
            <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
        </padding>

        <!-- Título -->
        <VBox alignment="CENTER" spacing="10.0">
            <Label text="Sistema de Gestión" styleClass="title">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>
            <Label text="Facturas y Garantías" styleClass="subtitle">
                <font>
                    <Font size="16.0"/>
                </font>
                <style>
                    -fx-text-fill: #666666;
                </style>
            </Label>
        </VBox>

        <!-- Formulario de login -->
        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10px; 
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>

            <!-- Usuario -->
            <VBox spacing="5.0">
                <Label text="Usuario:">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Label>
                <TextField fx:id="txtUsername" promptText="Ingrese su usuario"
                           style="-fx-font-size: 14px; -fx-padding: 10px;"/>
            </VBox>

            <!-- Contraseña -->
            <VBox spacing="5.0">
                <Label text="Contraseña:">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Label>
                <PasswordField fx:id="txtPassword" promptText="Ingrese su contraseña"
                              style="-fx-font-size: 14px; -fx-padding: 10px;"/>
            </VBox>

            <!-- Mensaje de error -->
            <Label fx:id="lblError" textFill="RED" wrapText="true" visible="false">
                <font>
                    <Font size="12.0"/>
                </font>
            </Label>

            <!-- Botón de login -->
            <Button fx:id="btnLogin" text="Iniciar Sesión" onAction="#handleLogin"
                    defaultButton="true" prefWidth="Infinity" prefHeight="45.0"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; 
                           -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;">
            </Button>
        </VBox>

        <!-- Información de usuarios de prueba -->
        <VBox spacing="5.0" alignment="CENTER" style="-fx-padding: 10px;">
            <Label text="Usuarios de prueba:" style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
            <Label text="admin / admin123 | carlos / carlos123 | marta / marta123" 
                   style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa;"/>
        </VBox>

    </VBox>

</AnchorPane>
